From f1a0448e42ce876a58c01da9f5b40c4991a44b27 Mon Sep 17 00:00:00 2001
From: Hilton Chain <hako@ultrarare.space>
Date: Sat, 10 Oct 2026 09:17:00 +0800
Subject: [PATCH] Set Guix System PATH for Tailscale SSH.

---
 ssh/tailssh/user_unix.go | 2 ++
 version/distro/distro.go | 3 +++
 2 files changed, 5 insertions(+)

diff --git a/ssh/tailssh/user_unix.go b/ssh/tailssh/user_unix.go
index eb1941886..5840f2af7 100644
--- a/ssh/tailssh/user_unix.go
+++ b/ssh/tailssh/user_unix.go
@@ -92,6 +92,8 @@ func defaultPathForUser(u *user.User) string {
 		return "/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games"
 	case distro.NixOS:
 		return defaultPathForUserOnNixOS(u)
+	case distro.Guix:
+		return "/run/privileged/bin:/run/current-system/profile/sbin:/run/current-system/profile/bin"
 	}
 	if isRoot {
 		return "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
diff --git a/version/distro/distro.go b/version/distro/distro.go
index 5407f8dae..2a6312bf7 100644
--- a/version/distro/distro.go
+++ b/version/distro/distro.go
@@ -34,6 +34,7 @@
 	Alpine    = Distro("alpine")
 	UBNT      = Distro("ubnt") // Ubiquiti Networks
 	JetKVM    = Distro("jetkvm")
+	Guix      = Distro("guix")
 )
 
 var distro lazy.SyncValue[Distro]
@@ -112,6 +113,8 @@ func linuxDistro() Distro {
 		return Alpine
 	case runtime.GOARCH == "arm" && isDeviceModel("JetKVM"):
 		return JetKVM
+	case have("/run/current-system/parameters"):
+		return Guix
 	}
 	return ""
 }
